# Copy to /var/www/sheplates-production/shared/.env on the server (chmod 600). Never commit the real file.
NODE_ENV=production
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_APP_URL=https://app.sheplates.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_TEST_AUTO_CONFIRM=false
SHEPLATES_TEST_AUTO_CONFIRM=false

# Payments (use live keys here, test keys on staging). The webhook URL in the Razorpay dashboard is https://app.sheplates.com/api/payments/razorpay/webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email through Amazon SES (see docs/SES_SETUP.md)
EMAIL_TRANSPORT=ses
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EMAIL_FROM=Sheplates <no-reply@sheplates.com>
EMAIL_REPLY_TO=support@sheplates.com
SES_CONFIGURATION_SET=sheplates-prod
SNS_TOPIC_ARN=
AGREEMENT_COPY_TO=partnersupport@sheplates.com
SHEPLATES_SIGNATORY_NAME=
SHEPLATES_SIGNATORY_TITLE=

# Scheduled jobs and signing
CRON_SECRET=
STATUS_PURGE_SECRET=
SIGNING_PEPPER=

OPENAI_API_KEY=
MAPS_API_KEY=
