# ShePlates runs in DEMO_MODE without external services.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:5173

# Optional production integrations
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY= 
# LOCAL TESTING ONLY. These two flags let the server auto-confirm newly created
# customer/vendor accounts without sending email. Never enable in production.
NEXT_PUBLIC_TEST_AUTO_CONFIRM=false
SHEPLATES_TEST_AUTO_CONFIRM=false
URUV_API_KEY=
URUV_API_BASE=https://api.uruv.ai/v1
AI_MODEL=uruv-chat
AI_IMAGE_MODEL=uruv-image
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=sheplates_schedule_reminder
MAPS_API_KEY=

# Scheduled cleanup of expired customer statuses (POST /api/statuses/purge with header x-cron-secret)
STATUS_PURGE_SECRET=

# Email through Amazon SES (EMAIL_TRANSPORT: ses | console | off). Keys stay on the server, never in the repo.
EMAIL_TRANSPORT=console
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EMAIL_FROM=Sheplates <no-reply@sheplates.com>
EMAIL_REPLY_TO=support@sheplates.com
SES_CONFIGURATION_SET=
# Topic that carries SES bounces/complaints to /api/email/ses-events
SNS_TOPIC_ARN=
# Shared secret for scheduled jobs (/api/cron/email-outbox, settlements, reminders), sent as header x-cron-secret
CRON_SECRET=
